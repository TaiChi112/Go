# Build stage
FROM golang:1.22 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o server main.go

# Run stage
FROM alpine:3.19
WORKDIR /app
COPY --from=builder /src/server /app/server
ENV APP_PORT=8080
EXPOSE 8080
CMD ["/app/server"]
